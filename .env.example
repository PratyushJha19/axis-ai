DATABASE_URL=
TEST_DATABASE_URL=
PORT=
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
DEMO_MODE=false
FREE_HOST_NOTIFICATIONS=false
LOG_LEVEL=
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
REMINDER_LEASE_MS=
REMINDER_TIMEOUT_MS=
REMINDER_MAX_ATTEMPTS=
REMINDER_MAX_RECONCILIATIONS=
REMINDER_RETRY_BASE_MS=
REMINDER_RETRY_CAP_MS=
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_CREDENTIALS_KEY_VERSION=
AI_CREDENTIALS_PREVIOUS_KEYS=
AI_REQUEST_TIMEOUT_MS=
AI_REQUESTS_PER_MINUTE=
AI_MAX_OUTPUT_TOKENS=
# M3 defaults to simulated delivery. Configure only after reviewing channel consent.
NOTIFICATION_MODE=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_COMMANDS_ENABLED=false
# Optional webhook mode; generate a private 32+ character secret, never commit it.
TELEGRAM_WEBHOOK_SECRET=
# Used only by the explicit telegram:webhook setup command, not application startup.
TELEGRAM_WEBHOOK_URL=
# Legacy WhatsApp configuration is retained for historical reference; runtime sends are disabled.
WHATSAPP_SANDBOX_MODE=true
NOTIFICATION_PUBLIC_ORIGIN=
# Sandbox credentials are never substituted with production credentials.
TWILIO_SANDBOX_ACCOUNT_SID=
TWILIO_SANDBOX_AUTH_TOKEN=
TWILIO_SANDBOX_WHATSAPP_FROM=
TWILIO_SANDBOX_CONTENT_SID=
TWILIO_PRODUCTION_ACCOUNT_SID=
TWILIO_PRODUCTION_AUTH_TOKEN=
TWILIO_PRODUCTION_WHATSAPP_FROM=
TWILIO_PRODUCTION_CONTENT_SID=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Optional bounded agent worker limits; blank uses the documented default.
AGENT_MAX_ITERATIONS=
AGENT_MAX_TOOLS=
AGENT_MAX_TOKENS=
AGENT_RESULT_BYTES=
AGENT_MODEL_TIMEOUT_MS=

# M6 Calendar reuses GOOGLE_CLIENT_ID/SECRET and AI_CREDENTIALS_* keyring.
# Add APP_ORIGIN/api/v1/calendar/callback as a Google redirect URI.
# Operator-only backups: private absolute directory, separate 32-byte base64 key.
BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=v1
# PostgreSQL 18 client binaries; leave blank when pg_dump/pg_restore are on PATH.
PG_BIN=
